{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "myapp",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "eec707e4-3d7c-46d7-8710-e1e218f0bdb0","database_name": "webmeapp" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "da58ee0742674e63a638af2c184b88fa" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
